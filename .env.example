# -----------------------------------------------------------------------------
# bvelt-radar — Environmental Secret Keys Template (.env.example)
# Configure these variables in Cloudflare Worker Secrets or local development.
# -----------------------------------------------------------------------------

# SECURITY & AUTH
# Service key required in authorization header (Bearer) to execute manual /run or /stats
FOUNDER_SERVICE_KEY="your_secure_random_key_here"

# TELEGRAM BOT INTEGRATION
# Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Target Chat ID from @userinfobot or group chat
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# AI COPYWRITING (Optional: graceful fallback to trade-psychology templates if omitted)
# Gemini Primary Cloud API Key (Required for primary cascade)
GEMINI_FOUNDER_API_KEY="your_gemini_api_key_here"
# Gemini Secondary Cloud API Key (Optional cascade backup key)
GEMINI_SECONDARY_API_KEY="your_secondary_gemini_api_key_here"
# Groq API Key (Optional: se mantiene como respaldo secundario del cascade)
GROQ_API_KEY="your_groq_api_key_here"

# HARVESTING & ENRICHMENT (Optional: scraper continues without them)
# Hunter.io API Key (Strict max 8 credits/day budget)
HUNTER_API_KEY="your_hunter_api_key_here"
# Abstract Email Validation API Key (Deliverability verification)
ABSTRACT_API_KEY="your_abstract_api_key_here"

# TRUST BUDGET (Optional)
TRUST_STACK_URL="https://your-trust-stack.example.com"
TRUST_SERVICE_KEY="your_trust_stack_api_key_here"

# GEOGRAPHICAL & TRADE TARGETS (Semicolon separated)
FOUNDING_CITIES="Tampa, FL;Orlando, FL;Austin, TX;Houston, TX;Atlanta, GA;Nashville, TN"
FOUNDING_TRADES="landscaping;lawn_care;hvac;plumbing;house_cleaning;pool_cleaning;handyman;roofing;pest_control"

# APP RUNTIME
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
